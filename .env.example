# ---------------------------------------------------------------------------
# Anuradha Solutions — environment
# Copy to .env.local for development. Everything is optional: without these the
# site runs fully, forms validate and respond, and integrations no-op.
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadata, canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="https://www.anuradhasolutions.in"

# --- PostgreSQL ------------------------------------------------------------
# Leave unset locally and lead/newsletter writes become no-ops (the request
# still succeeds). Apply db/schema.sql before setting this.
DATABASE_URL="postgresql://user:password@host:5432/anuradha?sslmode=require"
DATABASE_POOL_MAX="5"
# Set to "disable" only for a local Postgres without TLS.
DATABASE_SSL=""

# --- HubSpot CRM -----------------------------------------------------------
# Private app token with crm.objects.contacts read+write.
HUBSPOT_PRIVATE_APP_TOKEN=""

# --- Notifications ---------------------------------------------------------
# Incoming webhook for the #leads channel.
SLACK_LEADS_WEBHOOK_URL=""

# --- Resource downloads ----------------------------------------------------
# Base URL of the bucket holding resource files (no trailing slash).
RESOURCE_ASSET_BASE_URL=""

# --- Analytics -------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# --- Optional: assistant LLM fallback --------------------------------------
# Only needed if the off-script fallback in docs/12-chatbot-flow.md is enabled.
# The scripted flow works without it.
ANTHROPIC_API_KEY=""
